{
  "name": "@jonathand34/opencode-plugin-muse",
  "version": "0.1.9-fork.1",
  "private": true,
  "description": "Muse Code inside opencode as a LanguageModelV3 provider (fork of @rasyid_rafi/opencode-muse)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:offline": "bun test test/lifecycle.test.ts test/usage.test.ts test/replay.test.ts test/contributor-models.test.ts",
    "check": "tsc --noEmit -p tsconfig.json && bun test",
    "check:offline": "tsc --noEmit -p tsconfig.json && bun run test:offline",
    "repro": "bash scripts/repro.sh"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@muse-code/sdk": "1.4.15",
    "@opencode/plugin": "2.2.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "muse-code",
    "agent-harness",
    "provider",
    "mcp"
  ]
}
